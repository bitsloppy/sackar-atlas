license: CC-BY-4.0
repository-code: "https://github.com/bitsloppy/sackar-atlas"
url: "https://sackar-atlas.bitsloppy.com"
date-released: "2026-08-19"
keywords:
  - LGBTIQ
  - hate crimes
  - Sydney
  - NSW
  - Sackar Inquiry
  - SCOI
  - open data
  - public history
  - historical geography
