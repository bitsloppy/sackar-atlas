---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'about-ai');
const { Content } = page ? await render(page) : { Content: () => null };
---

<Layout
  title="AI use"
  description="How AI tools were used in building Sackar Atlas, and what human oversight applies."
>

  <div class="page-prose section">
    <div class="wa-stack wa-gap-xl">

      <!-- Page header -->
      <div class="wa-stack wa-gap-xs">
        <p class="breadcrumb"><a href="/about/">About the data</a> /</p>
        <h1>AI use</h1>
        <p class="subtitle">
          How AI tools were used in building this project, and what human oversight applies.
        </p>
      </div>

      <!-- The short version -->
      <wa-callout variant="neutral" open>
        <wa-icon slot="icon" name="circle-info"></wa-icon>
        <strong>The short version.</strong> AI tools (Claude, via OpenClaw) were used throughout
        this project. Anna Roberts oversaw and verified everything. No AI-generated content
        appears on this site without human review.
      </wa-callout>

      <!-- Keystatic-managed prose: What AI did / didn't do / uncertainty table -->
      <div class="prose-body">
        <Content />
      </div>

      <!-- Corrections -->
      <wa-callout variant="warning" open>
        <wa-icon slot="icon" name="triangle-exclamation"></wa-icon>
        If you find an error that may be the result of AI misreading or misrepresenting a
        source, please <a href="/corrections/">submit a correction</a>.
      </wa-callout>

      <!-- Footer nav -->
      <p class="back-link">
        <a href="/about/">← About the data</a>
      </p>

    </div>
  </div>

</Layout>

<style>
  .page-prose {
    max-width: 68ch;
    margin-inline: auto;
    padding-block: var(--wa-space-3xl);
  }

  .breadcrumb {
    font-size: var(--wa-font-size-s);
    color: var(--wa-color-text-quiet);
    margin: 0;
  }

  .breadcrumb a {
    color: var(--wa-color-text-quiet);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--site-brand);
    text-decoration: underline;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--wa-font-size-3xl);
    color: var(--site-brand);
    margin: 0;
    line-height: 1.15;
  }

  h2 {
    font-size: var(--wa-font-size-l);
    font-weight: 600;
    color: var(--wa-color-text-normal);
    margin: 0;
  }

  h3 {
    font-size: var(--wa-font-size-m);
    font-weight: 600;
    color: var(--wa-color-text-normal);
    margin: 0;
  }

  p, li {
    font-size: var(--wa-font-size-m);
    color: var(--wa-color-text-normal);
    line-height: 1.65;
    margin: 0;
  }

  .subtitle {
    font-size: var(--wa-font-size-m);
    color: var(--wa-color-text-quiet);
  }

  ul {
    margin: 0;
    padding-inline-start: 1.4em;
  }

  ul li + li {
    margin-block-start: var(--wa-space-xs);
  }

  code {
    font-size: 0.88em;
    background-color: var(--wa-color-neutral-95);
    padding: 0.1em 0.35em;
    border-radius: var(--wa-border-radius-s);
    color: var(--wa-color-text-normal);
  }

  .uncertainty-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--wa-font-size-s);
  }

  .uncertainty-table th {
    text-align: left;
    padding: var(--wa-space-xs) var(--wa-space-s);
    background-color: var(--wa-color-neutral-95);
    font-weight: 600;
    color: var(--wa-color-text-normal);
    border-bottom: 1px solid var(--wa-color-surface-border);
  }

  .uncertainty-table td {
    padding: var(--wa-space-xs) var(--wa-space-s);
    border-bottom: 1px solid var(--wa-color-surface-border);
    color: var(--wa-color-text-normal);
    vertical-align: top;
  }

  .uncertainty-table tr:last-child td {
    border-bottom: none;
  }

  .back-link {
    padding-block-start: var(--wa-space-m);
    border-top: 1px solid var(--wa-color-surface-border);
  }

  .back-link a {
    font-size: var(--wa-font-size-s);
    color: var(--wa-color-text-quiet);
    text-decoration: none;
  }

  .back-link a:hover {
    color: var(--site-brand);
    text-decoration: underline;
  }

  /* Keystatic prose content vertical rhythm */
  .prose-body :global(h2) {
    font-size: var(--wa-font-size-l);
    font-weight: 600;
    color: var(--wa-color-text-normal);
    margin: 0;
    margin-block-start: var(--wa-space-xl);
  }
  .prose-body :global(h2:first-child) { margin-block-start: 0; }
  .prose-body :global(h3) {
    font-size: var(--wa-font-size-m);
    font-weight: 600;
    color: var(--wa-color-text-normal);
    margin: 0;
    margin-block-start: var(--wa-space-m);
  }
  .prose-body :global(p) { margin: 0; margin-block-start: var(--wa-space-s); }
  .prose-body :global(h2 + p),
  .prose-body :global(h3 + p) { margin-block-start: var(--wa-space-2xs); }
  .prose-body :global(ul) { margin: 0; padding-inline-start: 1.4em; margin-block-start: var(--wa-space-s); }
  .prose-body :global(li + li) { margin-block-start: var(--wa-space-xs); }
  .prose-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--wa-font-size-s);
    margin-block-start: var(--wa-space-s);
  }
  .prose-body :global(th) {
    text-align: left;
    padding: var(--wa-space-xs) var(--wa-space-s);
    background-color: var(--wa-color-neutral-95);
    font-weight: 600;
    border-bottom: 1px solid var(--wa-color-surface-border);
  }
  .prose-body :global(td) {
    padding: var(--wa-space-xs) var(--wa-space-s);
    border-bottom: 1px solid var(--wa-color-surface-border);
    vertical-align: top;
  }
  .prose-body :global(tr:last-child td) { border-bottom: none; }
</style>
