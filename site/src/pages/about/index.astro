---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'about');
const { Content } = page ? await render(page) : { Content: () => null };
---

<Layout
  title="About the data"
  description="What Sackar Atlas is, how the source documents are prepared, and how to use or cite the data."
>

  <div class="page-prose section">
    <div class="wa-stack wa-gap-xl">

      <!-- Page header -->
      <div class="wa-stack wa-gap-xs">
        <h1>About</h1>
        <p class="subtitle">
          What Sackar Atlas is, why it exists, and how the data was built.
        </p>
      </div>

      <!-- GitHub callout -->
      <wa-callout variant="neutral" open>
        <wa-icon slot="icon" name="code-branch"></wa-icon>
        All source documents, structured data, and site code are open source on
        <a href="https://github.com/bitsloppy/sackar-atlas">GitHub ↗</a>.
        Data is published under CC-BY 4.0.
      </wa-callout>

      <!-- Keystatic-managed prose: What this is / How prepared / How to use -->
      <div class="prose-body">
        <Content />
      </div>

      <!-- The sources -->
      <div class="wa-stack wa-gap-m">
        <h2>The primary sources</h2>
        <p>
          The project draws on seven primary source documents. All are publicly available. All are committed to the repository as clean Markdown files. PDFs are available via the download links below.
        </p>

        <table class="sources-table">
          <thead>
            <tr>
              <th>Document</th>
              <th>Publisher</th>
              <th>Year</th>
              <th>Download</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>SCOI Volume 1 — Executive summary, context, methodology</td>
              <td>Special Commission of Inquiry (Sackar J)</td>
              <td>2023</td>
              <td><a href="https://www.nsw.gov.au/departments-and-agencies/the-cabinet-office/resources/special-commissions-of-inquiry/lgbtiq-hate-crimes" target="_blank" rel="noopener">NSW Government ↗</a></td>
            </tr>
            <tr>
              <td>SCOI Volume 2 — Category A and B deaths</td>
              <td>Special Commission of Inquiry (Sackar J)</td>
              <td>2023</td>
              <td><a href="https://www.nsw.gov.au/departments-and-agencies/the-cabinet-office/resources/special-commissions-of-inquiry/lgbtiq-hate-crimes" target="_blank" rel="noopener">NSW Government ↗</a></td>
            </tr>
            <tr>
              <td>SCOI Volume 3 — Strike forces, institutional failures, recommendations</td>
              <td>Special Commission of Inquiry (Sackar J)</td>
              <td>2023</td>
              <td><a href="https://www.nsw.gov.au/departments-and-agencies/the-cabinet-office/resources/special-commissions-of-inquiry/lgbtiq-hate-crimes" target="_blank" rel="noopener">NSW Government ↗</a></td>
            </tr>
            <tr>
              <td>SCOI Annexures</td>
              <td>Special Commission of Inquiry (Sackar J)</td>
              <td>2023</td>
              <td><a href="https://www.nsw.gov.au/departments-and-agencies/the-cabinet-office/resources/special-commissions-of-inquiry/lgbtiq-hate-crimes" target="_blank" rel="noopener">NSW Government ↗</a></td>
            </tr>
            <tr>
              <td>Strike Force Parrabell Final Report</td>
              <td>NSW Police Force</td>
              <td>2018</td>
              <td><a href="https://www.police.nsw.gov.au/safety_and_prevention/your_community/working_with_lgbtqia/strike_force_parrabell" target="_blank" rel="noopener">NSW Police ↗</a></td>
            </tr>
            <tr>
              <td>In Pursuit of Truth and Justice: Documenting Gay and Transgender Prejudice Killings in NSW in the Late 20th Century</td>
              <td>ACON</td>
              <td>2018</td>
              <td><a href="https://www.aconhealth.org.au/report_into_historic_gay_hate_murders_calls_for_justice_and_healing" target="_blank" rel="noopener">ACON website ↗</a></td>
            </tr>
            <tr>
              <td>Report No. 58 — Gay and Transgender Hate Crimes 1970–2010</td>
              <td>NSW Legislative Council Committee on Social Issues</td>
              <td>2021</td>
              <td><a href="https://www.parliament.nsw.gov.au/committees/inquiries/Pages/inquiry-details.aspx?pk=1874" target="_blank" rel="noopener">NSW Parliament ↗</a></td>
            </tr>
          </tbody>
        </table>
      </div>



      <!-- Citation -->
      <div class="wa-stack wa-gap-m">
        <h2>Citing this project</h2>
        <p>Suggested citation (AGSM author–date):</p>
        <blockquote>
          Roberts A (2026) <em>Sackar Atlas</em>, available at
          https://sackar-atlas.soft-hill-5225.workers.dev
        </blockquote>
        <p>
          For individual records, cite the specific page URL and the primary source paragraph
          it draws on.
        </p>
      </div>

      <!-- Corrections CTA -->
      <p class="corrections-link">
        Something wrong? <a href="/corrections/">Submit a correction →</a>
      </p>

      <!-- Sub-pages -->
      <div class="wa-stack wa-gap-s">
        <h2>Also in this section</h2>
        <a href="/about/ai/" class="sub-page-link">
          <wa-icon name="robot"></wa-icon>
          AI use — how AI tools were used in building this project
        </a>
      </div>

    </div>
  </div>

</Layout>

<style>
  .page-prose {
    max-width: 72ch;
    margin-inline: auto;
    padding-block: var(--wa-space-3xl);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--wa-font-size-3xl);
    color: var(--site-brand);
    margin: 0;
    line-height: 1.15;
  }

  h2 {
    font-size: var(--wa-font-size-l);
    font-weight: 600;
    color: var(--wa-color-text-normal);
    margin: 0;
  }

  h3 {
    font-size: var(--wa-font-size-m);
    font-weight: 600;
    color: var(--wa-color-text-normal);
    margin: 0;
  }

  p, li {
    font-size: var(--wa-font-size-m);
    color: var(--wa-color-text-normal);
    line-height: 1.65;
    margin: 0;
  }

  .subtitle {
    font-size: var(--wa-font-size-m);
    color: var(--wa-color-text-quiet);
  }

  ul {
    margin: 0;
    padding-inline-start: 1.4em;
  }

  ul li + li {
    margin-block-start: var(--wa-space-xs);
  }

  code {
    font-size: 0.88em;
    background-color: var(--wa-color-neutral-95);
    padding: 0.1em 0.35em;
    border-radius: var(--wa-border-radius-s);
    color: var(--wa-color-text-normal);
  }

  blockquote {
    margin: 0;
    padding: var(--wa-space-s) var(--wa-space-m);
    border-left: 3px solid var(--site-brand);
    background-color: var(--wa-color-neutral-95);
    border-radius: 0 var(--wa-border-radius-m) var(--wa-border-radius-m) 0;
    font-style: italic;
    font-size: var(--wa-font-size-m);
    color: var(--wa-color-text-normal);
  }

  /* Sources table */
  .sources-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--wa-font-size-s);
  }

  .sources-table th {
    text-align: left;
    padding: var(--wa-space-xs) var(--wa-space-s);
    background-color: var(--wa-color-neutral-95);
    font-weight: 600;
    color: var(--wa-color-text-normal);
    border-bottom: 2px solid var(--wa-color-surface-border);
  }

  .sources-table td {
    padding: var(--wa-space-xs) var(--wa-space-s);
    border-bottom: 1px solid var(--wa-color-surface-border);
    color: var(--wa-color-text-normal);
    vertical-align: top;
  }

  .sources-table tr:last-child td {
    border-bottom: none;
  }

  .corrections-link {
    padding: var(--wa-space-m);
    background-color: var(--wa-color-neutral-95);
    border-radius: var(--wa-border-radius-m);
    font-size: var(--wa-font-size-s);
    color: var(--wa-color-text-quiet);
  }

  /* Sub-page links */
  .sub-page-link {
    display: flex;
    align-items: center;
    gap: var(--wa-space-s);
    padding: var(--wa-space-s) var(--wa-space-m);
    border: 1px solid var(--wa-color-surface-border);
    border-radius: var(--wa-border-radius-m);
    color: var(--site-brand);
    text-decoration: none;
    font-size: var(--wa-font-size-m);
    font-weight: 500;
    transition: background-color 0.12s ease;
  }

  .sub-page-link:hover {
    background-color: var(--wa-color-neutral-95);
  }

  /* Keystatic prose content vertical rhythm */
  .prose-body :global(h2) {
    font-size: var(--wa-font-size-l);
    font-weight: 600;
    color: var(--wa-color-text-normal);
    margin: 0;
    margin-block-start: var(--wa-space-xl);
  }
  .prose-body :global(h2:first-child) { margin-block-start: 0; }
  .prose-body :global(h3) {
    font-size: var(--wa-font-size-m);
    font-weight: 600;
    color: var(--wa-color-text-normal);
    margin: 0;
    margin-block-start: var(--wa-space-m);
  }
  .prose-body :global(p) { margin: 0; margin-block-start: var(--wa-space-s); }
  .prose-body :global(h2 + p),
  .prose-body :global(h3 + p) { margin-block-start: var(--wa-space-2xs); }
  .prose-body :global(ul) { margin: 0; padding-inline-start: 1.4em; margin-block-start: var(--wa-space-s); }
  .prose-body :global(li + li) { margin-block-start: var(--wa-space-xs); }
  .prose-body :global(a) { color: var(--site-brand); }
</style>
