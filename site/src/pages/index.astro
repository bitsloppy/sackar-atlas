---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry, render } from 'astro:content';

// Count published cases for the stats banner
const allCases = await getCollection('cases', ({ data }) => data.published === true);
const caseCount = allCases.length;

// Hero body text — editable via Keystatic
const homePage = await getEntry('pages', 'home');
const { Content: HeroContent } = homePage ? await render(homePage) : { Content: () => null };

// About section — editable via Keystatic
const homeAbout = await getEntry('pages', 'home-about');
const { Content: AboutContent } = homeAbout ? await render(homeAbout) : { Content: () => null };

// Site settings (strapline, footer text) — editable via Keystatic
const siteSettings = await getEntry('pages', 'site-settings');
const strapline = siteSettings?.data.strapline ?? 'Making the NSW Special Commission of Inquiry into LGBTIQ Hate Crimes navigable.';
---

<Layout title="Home">
  <!-- ─── Hero ─── -->
  <section class="hero section">
    <div class="hero-inner wa-stack wa-gap-l">
      <h1 class="display-title">Sackar Atlas</h1>
      <p class="hero-strapline">
        {strapline}
      </p>
      <div class="hero-body">
        <HeroContent />
      </div>
      <div class="wa-cluster wa-gap-s">
        <a href="/cases/" class="cta-primary">Browse the cases</a>
        <a href="/map/" class="cta-secondary">Open the map</a>
      </div>
    </div>
  </section>
  <!-- ─── Hero attribution ─── -->
  <div class="hero-caption section" role="note">
    <p>
      Black and white photograph of police and plainclothes officers moving protesters along near St James Station during gay liberation demonstrations, Sydney, New South Wales, September 1978.  
      &nbsp;<a href="https://archival.sl.nsw.gov.au/Details/archive/110369600" target="_blank" rel="noopener">Mitchell Library, State Library of New South Wales</a> and Courtesy SEARCH Foundation.
      &nbsp;<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>
    </p>
  </div>

  <!-- ─── Stats strip ─── -->
  <section class="stats-strip section">
    <div class="stats-grid">
      <div class="stat">
        <span class="stat-number">{caseCount}</span>
        <span class="stat-label">cases published</span>
      </div>
      <div class="stat">
        <span class="stat-number">2023</span>
        <span class="stat-label">SCOI report</span>
      </div>
      <div class="stat">
        <span class="stat-number">3 vols</span>
        <span class="stat-label">of public record</span>
      </div>
      <div class="stat">
        <span class="stat-number">30+</span>
        <span class="stat-label">deaths examined</span>
      </div>
    </div>
  </section>

  <!-- ─── Section nav cards ─── -->
  <section class="nav-cards-section section">
    <h2 class="section-heading">Explore the atlas</h2>
    <div class="nav-cards wa-grid wa-gap-l">

      <div class="nav-card-wrap nav-card-cases">
        <a href="/cases/" class="nav-card-link">
          <wa-card appearance="filled-outlined" with-footer>
            <div class="nav-card-icon-row">
              <wa-icon name="user" variant="solid" class="nav-card-icon"></wa-icon>
              <strong class="nav-card-label">Cases</strong>
            </div>
            <p class="nav-card-desc">
              Individual deaths examined by the Sackar Inquiry — the people, the
              evidence, and how institutions responded.
            </p>
            <span slot="footer" class="nav-card-footer-link">
              Browse cases
              <wa-icon name="arrow-right" variant="solid"></wa-icon>
            </span>
          </wa-card>
        </a>
      </div>

      <div class="nav-card-wrap nav-card-locations">
        <a href="/locations/" class="nav-card-link">
          <wa-card appearance="filled-outlined" with-footer>
            <div class="nav-card-icon-row">
              <wa-icon name="location-dot" variant="solid" class="nav-card-icon"></wa-icon>
              <strong class="nav-card-label">Locations</strong>
            </div>
            <p class="nav-card-desc">
              Two Sydney's side by side – beats and venues next to police stations and crime scenes – the geography that defines this history.
            </p>
            <span slot="footer" class="nav-card-footer-link">
              Browse locations
              <wa-icon name="arrow-right" variant="solid"></wa-icon>
            </span>
          </wa-card>
        </a>
      </div>

      <div class="nav-card-wrap nav-card-events">
        <a href="/events/" class="nav-card-link">
          <wa-card appearance="filled-outlined" with-footer>
            <div class="nav-card-icon-row">
              <wa-icon name="calendar-days" variant="solid" class="nav-card-icon"></wa-icon>
              <strong class="nav-card-label">Events</strong>
            </div>
            <p class="nav-card-desc">
              Activism, law reform, police operations, and cultural moments — the broader
              history alongside the violence.
            </p>
            <span slot="footer" class="nav-card-footer-link">
              Browse events
              <wa-icon name="arrow-right" variant="solid"></wa-icon>
            </span>
          </wa-card>
        </a>
      </div>

      <div class="nav-card-wrap nav-card-people">
        <a href="/people/" class="nav-card-link">
          <wa-card appearance="filled-outlined" with-footer>
            <div class="nav-card-icon-row">
              <wa-icon name="users" variant="solid" class="nav-card-icon"></wa-icon>
              <strong class="nav-card-label">People</strong>
            </div>
            <p class="nav-card-desc">
              Victims, activists, witnesses, police commissioners — people named in the
              public record of these events.
            </p>
            <span slot="footer" class="nav-card-footer-link">
              Browse people
              <wa-icon name="arrow-right" variant="solid"></wa-icon>
            </span>
          </wa-card>
        </a>
      </div>

    </div>
  </section>

  <!-- ─── About ─── -->
  <section class="about-section section">
    <div class="about-inner wa-stack wa-gap-l">
      <h2>About this project</h2>
      <div class="about-body">
        <AboutContent />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ─── Hero ──────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    background-image: url('/images/hero-bg.jpg');
    background-size: cover;
    background-position: left 70%;
    padding-block: var(--wa-space-5xl);
    border-bottom: var(--wa-border-width-s) solid var(--wa-color-surface-border);
    overflow: hidden;
    min-height: 22rem;
  }

  /* Semi-transparent gradient overlay — darker on the left where text sits */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(0, 28, 46, 0.80) 0%,
      rgba(0, 28, 46, 0.65) 55%,
      rgba(0, 28, 46, 0.48) 100%
    );
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 52ch;
  }

  .display-title {
    font-family: var(--font-display);
    font-size: var(--wa-font-size-4xl);
    font-weight: normal;
    margin: 0;
    color: #ffffff;
    letter-spacing: 0.01em;
  }

  .hero-strapline {
    font-size: var(--wa-font-size-l);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.95);
    margin: 0;
    line-height: 1.4;
  }

  .hero-body {
    font-size: var(--wa-font-size-m);
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    line-height: 1.65;
    max-width: 60ch;
  }
  .hero-body :global(p) {
    font-size: inherit;
    color: inherit;
    margin: 0;
    line-height: inherit;
  }

  /* CTA buttons — inverted for dark hero background */
  .cta-primary {
    display: inline-block;
    background-color: #ffffff;
    color: var(--site-brand);
    text-decoration: none;
    padding: var(--wa-space-xs) var(--wa-space-l);
    border-radius: var(--wa-border-radius-m);
    font-weight: 600;
    font-size: var(--wa-font-size-s);
    transition: opacity 0.12s ease;
  }

  .cta-primary:hover {
    opacity: 0.9;
  }

  .cta-secondary {
    display: inline-block;
    background-color: transparent;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    padding: var(--wa-space-xs) var(--wa-space-l);
    border-radius: var(--wa-border-radius-m);
    font-weight: 600;
    font-size: var(--wa-font-size-s);
    border: var(--wa-border-width-s) solid rgba(255, 255, 255, 0.55);
    transition: background-color 0.12s ease;
  }

  .cta-secondary:hover {
    background-color: rgba(255, 255, 255, 0.12);
  }

  /* ─── Hero attribution ───────────────────────────────────────────────────── */
  .hero-caption {
    padding-block: var(--wa-space-s);
    background-color: var(--wa-color-surface-lowered);
    border-bottom: var(--wa-border-width-s) solid var(--wa-color-surface-border);
  }

  .hero-caption p {
    font-size: var(--wa-font-size-xs);
    color: var(--wa-color-text-quiet);
    margin: 0;
    line-height: 1.5;
  }

  .hero-caption a {
    color: var(--wa-color-text-link);
  }

  /* ─── Stats strip ────────────────────────────────────────────────────────── */
  .stats-strip {
    background-color: var(--site-brand);
    padding-block: var(--wa-space-2xl);
  }

  .stats-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--wa-space-2xl);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--wa-space-3xs);
  }

  .stat-number {
    font-size: var(--wa-font-size-3xl);
    font-weight: 700;
    color: #ffffff;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: var(--wa-font-size-s);
    color: rgba(255, 255, 255, 0.75);
    font-weight: 400;
  }

  /* ─── Section nav cards ──────────────────────────────────────────────────── */
  .nav-cards-section {
    padding-block: var(--wa-space-4xl);
  }

  .section-heading {
    font-size: var(--wa-font-size-xl);
    font-weight: 600;
    margin: 0 0 var(--wa-space-2xl) 0;
    color: var(--wa-color-text-normal);
  }

  .nav-cards {
    --min-column-size: 20rem;
  }

  /* Coloured left-border accent on the wrapper (not on wa-card directly) */
  .nav-card-wrap {
    border-left: var(--wa-space-2xs) solid transparent;
    border-radius: var(--wa-border-radius-m);
  }

  .nav-card-cases     { border-left-color: var(--site-cases); }
  .nav-card-locations { border-left-color: var(--site-locations); }
  .nav-card-events    { border-left-color: var(--site-events); }
  .nav-card-people    { border-left-color: var(--site-people); }

  .nav-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .nav-card-link wa-card {
    height: 100%;
    transition: box-shadow 0.15s ease;
  }

  .nav-card-link:hover wa-card {
    box-shadow: var(--wa-shadow-m);
  }

  /* Card internal spacing via documented --spacing custom property */
  .nav-card-wrap wa-card {
    --spacing: var(--wa-space-xl);
  }

  .nav-card-icon-row {
    display: flex;
    align-items: center;
    gap: var(--wa-space-s);
    margin-bottom: var(--wa-space-m);
  }

  .nav-card-icon {
    font-size: var(--wa-font-size-2xl);
    flex-shrink: 0;
  }

  .nav-card-cases     .nav-card-icon { color: var(--site-cases); }
  .nav-card-locations .nav-card-icon { color: var(--site-locations); }
  .nav-card-events    .nav-card-icon { color: var(--site-events); }
  .nav-card-people    .nav-card-icon { color: var(--site-people); }

  .nav-card-label {
    font-size: var(--wa-font-size-l);
    font-weight: 700;
    color: var(--wa-color-text-normal);
  }

  .nav-card-desc {
    font-size: var(--wa-font-size-s);
    color: var(--wa-color-text-quiet);
    margin: 0;
    line-height: 1.55;
  }

  .nav-card-footer-link {
    display: flex;
    align-items: center;
    gap: var(--wa-space-2xs);
    font-size: var(--wa-font-size-s);
    font-weight: 500;
    color: var(--wa-color-text-link);
  }

  /* ─── About section ──────────────────────────────────────────────────────── */
  .about-section {
    padding-block: var(--wa-space-4xl);
    background-color: var(--wa-color-surface-lowered);
    border-top: var(--wa-border-width-s) solid var(--wa-color-surface-border);
  }

  .about-inner {
    max-width: 65ch;
  }

  .about-inner h2 {
    font-size: var(--wa-font-size-xl);
    font-weight: 600;
    margin: 0;
  }

  .about-inner p {
    font-size: var(--wa-font-size-s);
    color: var(--wa-color-text-quiet);
    margin: 0;
    line-height: 1.65;
  }

  .about-inner a {
    color: var(--wa-color-text-link);
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: var(--wa-space-m);
  }

  .about-body :global(p) {
    font-size: var(--wa-font-size-s);
    color: var(--wa-color-text-quiet);
    margin: 0;
    line-height: 1.65;
  }

  .about-body :global(a) {
    color: var(--wa-color-text-link);
  }
</style>

<script>
  import '@awesome.me/webawesome/dist/components/card/card.js';
  import '@awesome.me/webawesome/dist/components/icon/icon.js';
</script>
