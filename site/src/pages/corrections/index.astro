---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
// Vite resolves this at build time — no runtime fs access needed
import rawMd from '../../../../data/corrections.md?raw';

// Extract entries: lines that start with [YYYY-MM-DD]
const entries = rawMd
  .split('\n')
  .filter(line => /^\[\d{4}-\d{2}-\d{2}\]/.test(line.trim()));

// Keystatic-managed policy text
const introPage = await getEntry('pages', 'corrections-intro');
const correctionsEmail = introPage?.data.corrections_email ?? 'corrections@bitsloppy.com';
const { Content } = introPage ? await render(introPage) : { Content: () => null };
---

<Layout title="Corrections" description="How to submit a correction to the Sackar Atlas data. Corrections register.">

  <div class="page-prose section">
    <div class="wa-stack wa-gap-xl">

      <!-- Page header -->
      <div class="wa-stack wa-gap-xs">
        <h1>Corrections</h1>
        <p class="subtitle">How to submit a correction to the Sackar Atlas data.</p>
      </div>

      <!-- Keystatic-managed policy prose -->
      <div class="prose-body">
        <Content />
      </div>

      <!-- Corrections register -->
      <div class="wa-stack wa-gap-m">
        <h2>Corrections register</h2>
        {entries.length === 0 ? (
          <wa-callout variant="neutral" open>
            <wa-icon slot="icon" name="circle-check"></wa-icon>
            No corrections on record.
          </wa-callout>
        ) : (
          <ul class="register-list">
            {entries.map(entry => (
              <li>{entry}</li>
            ))}
          </ul>
        )}
      </div>

      <!-- Footer nav -->
      <p class="back-link">
        <a href="/">← Back to Sackar Atlas</a>
      </p>

    </div>
  </div>

</Layout>

<style>
  .page-prose {
    max-width: 68ch;
    margin-inline: auto;
    padding-block: var(--wa-space-3xl);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--wa-font-size-3xl);
    color: var(--site-brand);
    margin: 0;
    line-height: 1.15;
  }

  h2 {
    font-size: var(--wa-font-size-l);
    font-weight: 600;
    color: var(--wa-color-text-normal);
    margin: 0;
  }

  h3 {
    font-size: var(--wa-font-size-m);
    font-weight: 600;
    color: var(--wa-color-text-normal);
    margin: 0;
  }

  p, li {
    font-size: var(--wa-font-size-m);
    color: var(--wa-color-text-normal);
    line-height: 1.65;
    margin: 0;
  }

  .subtitle {
    font-size: var(--wa-font-size-m);
    color: var(--wa-color-text-quiet);
  }

  ul {
    margin: 0;
    padding-inline-start: 1.4em;
  }

  ul li + li {
    margin-block-start: var(--wa-space-xs);
  }

  .register-list {
    list-style: none;
    padding: 0;
    font-size: var(--wa-font-size-s);
    color: var(--wa-color-text-quiet);
  }

  .register-list li {
    padding: var(--wa-space-xs) 0;
    border-bottom: 1px solid var(--wa-color-surface-border);
    font-size: var(--wa-font-size-s);
  }

  .back-link {
    padding-block-start: var(--wa-space-m);
    border-top: 1px solid var(--wa-color-surface-border);
  }

  .back-link a {
    font-size: var(--wa-font-size-s);
    color: var(--wa-color-text-quiet);
    text-decoration: none;
  }

  .back-link a:hover {
    color: var(--site-brand);
    text-decoration: underline;
  }

  .prose-body :global(h2) {
    font-size: var(--wa-font-size-l);
    font-weight: 600;
    color: var(--wa-color-text-normal);
    margin: 0;
    margin-block-start: var(--wa-space-xl);
  }
  .prose-body :global(h2:first-child) { margin-block-start: 0; }
  .prose-body :global(h3) {
    font-size: var(--wa-font-size-m);
    font-weight: 600;
    margin: 0;
    margin-block-start: var(--wa-space-m);
  }
  .prose-body :global(p) { margin: 0; margin-block-start: var(--wa-space-s); }
  .prose-body :global(h2 + p),
  .prose-body :global(h3 + p) { margin-block-start: var(--wa-space-2xs); }
  .prose-body :global(ul) { margin: 0; padding-inline-start: 1.4em; margin-block-start: var(--wa-space-s); }
  .prose-body :global(li + li) { margin-block-start: var(--wa-space-xs); }
  .prose-body :global(a) { color: var(--site-brand); }
</style>
