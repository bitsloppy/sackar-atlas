# sackar-atlas site — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored. Never commit the real .env.

# ── Zotero ──────────────────────────────────────────────────────────────────
# The numeric Group ID from your Zotero group URL:
#   https://www.zotero.org/groups/YOUR_GROUP_ID/sackar-atlas
ZOTERO_GROUP_ID=

# Read-only API key for the sackar-atlas group.
# Optional if the group library is set to public read, but recommended
# for higher rate limits. Create at: https://www.zotero.org/settings/keys/new
ZOTERO_API_KEY=
